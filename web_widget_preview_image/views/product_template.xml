<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_template_form_image_cropper" model="ir.ui.view">
        <field name="name">Product Template Image Cropper</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="/form[@name='Product Template']//field[@name='image_1920']" position="attributes">
                <attribute name="force_save">1</attribute>
                <attribute name="widget">image_cropper</attribute>
            </xpath>
        </field>
    </record>
</odoo>