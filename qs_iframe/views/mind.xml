<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_qs_mind_map_list" model="ir.ui.view">
            <field name="name">View Mind Map list</field>
            <field name="model">qs.mind.map</field>
            <field name="arch" type="xml">
                <list multi_edit="true" sample="1">
                    <field name="sequence" optional="show" widget="handle"/>
                    <field name="display_name" class="text-danger"/>
                    <field name="lang" optional="show"/>
                    <field name="color" optional="show" widget="color_picker"/>
                    <field name="active" optional="show"/>
                </list>
            </field>
        </record>
        <record id="view_qs_mind_map_form" model="ir.ui.view">
            <field name="name">View Mind Map Form</field>
            <field name="model">qs.mind.map</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string="Open Mind" name="action_open_mindmap_iframe" type="object" data-hotkey="shift+g"
                                class="oe_highlight"/>
                        <button string="Open Excalidraw" name="action_open_excalidraw_iframe" type="object"
                                class="oe_highlight"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" class="text-danger"/>
                            </h1>
                        </div>
                        <group>
                            <group col="1" colspan="1">
                                <field name="lang"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Setting">
                                <group string="">
                                    <field name="local_config"/>
                                    <field name="mind_config"/>
                                    <field name="mind_data"/>
                                    <field name="excalidraw_data"/>
                                </group>
                            </page>
                            <page string="Setting">
                                <group string="">
                                    <field name="sequence"/>
                                    <field name="color" widget="color_picker"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_qs_mind_map_search" model="ir.ui.view">
            <field name="name">View Mind Map Search</field>
            <field name="model">qs.mind.map</field>
            <field name="arch" type="xml">
                <search string="Search Mind Map">
                    <field name="name" string="Name"/>
                    <field name="lang"/>
                    <field name="color"/>
                    <field name="sequence"/>
                    <field name="active"/>
                </search>
            </field>
        </record>
        <record id="view_qs_mind_map_kanban" model="ir.ui.view">
            <field name="name">View Mind Map Kanban</field>
            <field name="model">qs.mind.map</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" sample="1" quick_create="false" highlight_color="color">
                    <field name="lang"/>
                    <field name="color"/>
                    <field name="sequence"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="menu">
                            <t t-if="widget.deletable">
                                <a type="delete" class="dropdown-item">Delete</a>
                            </t>
                            <field name="color" widget="kanban_color_picker"/>
                        </t>
                        <t t-name="card" class="flex-row">
                            <main class="pe-2">
                                <div t-if="record.lang.raw_value" class="text-truncate">
                                    <field class="col-8 text-primary" name="lang"/>
                                </div>
                                <div t-if="record.color.raw_value" class="text-truncate">
                                    <field class="col-8 text-primary" name="color"/>
                                </div>
                                <div t-if="record.sequence.raw_value" class="text-truncate">
                                    <field class="col-8 text-primary" name="sequence"/>
                                </div>
                                <div t-if="record.active.raw_value" class="text-truncate">
                                    <field class="col-8" name="active" widget="boolean_toggle"/>
                                </div>
                                <footer>
                                    <div class="d-flex mb-0 h5">
                                        <field name="display_name" class="text-danger"/>
                                    </div>
                                </footer>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="act_window_qs_mind_map" model="ir.actions.act_window">
            <field name="name">Mind Map</field>
            <field name="res_model">qs.mind.map</field>
            <field name="view_mode">list,kanban,form,search</field>
        </record>
        <record id="action_iframe_mind" model="ir.actions.client">
            <field name="name">Iframe Mind</field>
            <field name="tag">qs_iframe.iframe_mind</field>
        </record>
        <record id="action_iframe_excalidraw" model="ir.actions.client">
            <field name="name">Iframe Excalidraw</field>
            <field name="tag">qs_iframe.excalidraw</field>
        </record>
        <menuitem name="Mind Map" id="qs_iframe.menu_4" parent="qs_iframe.menu_root"
                  action="qs_iframe.act_window_qs_mind_map"/>
    </data>
</odoo>