<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="qs_cn_icp.login_layout" inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('container')]" position="after">
            <div class="text-center py-3 small text-secondary z-100">
                <t t-if="icp_police_number and icp_display_name">
                    <p class="mt-2 mb-0">
                        <img src="/qs_cn_icp/static/description/icp.png" alt="ICP ICON"
                             style="width: 20px; height: 20px; margin-right: 12px; vertical-align: top; display: inline-block;"/>
                        <a href="https://beian.miit.gov.cn/" target="_blank" class="mt-3"
                           style="height: 20px; line-height: 20px; color: var(--link-color); margin-left: -7px; font-size: 14px;">
                            <t t-out="icp_display_name"/>
                        </a>
                        <span style="margin:0 8px;"/>
                        <a t-att-href="'https://beian.mps.gov.cn/#/query/webSearch?code=' + ''.join([c for c in icp_police_number if c.isdigit()])"
                           rel="noreferrer" target="_blank" class="mt-3"
                           style="height: 20px; line-height: 20px; color: var(--link-color); margin-left: -7px; font-size: 14px;">
                            <t t-out="icp_police_number"/>
                        </a>
                    </p>
                </t>
            </div>
        </xpath>
    </template>
</odoo>