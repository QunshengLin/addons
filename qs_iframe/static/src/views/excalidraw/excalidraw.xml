<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="qs_iframe.excalidrawPostMessage">
        <div class="o_action_manager h-100 w-100 d-flex flex-column">
            <div class="o_form_view o_view_controller o_action h-100 w-100 d-flex flex-column">
                <div class="o_form_view_container flex-grow-1 d-flex flex-column" style="min-height: 0;">
                    <div class="o_control_panel d-flex flex-column gap-3 px-3 pt-2" data-command-category="actions">
                        <div class="o_control_panel_main d-flex flex-wrap flex-lg-nowrap justify-content-between align-items-lg-start gap-2 gap-lg-3 flex-grow-1">
                            <div class="o_control_panel_breadcrumbs d-flex align-items-center gap-1 order-0 h-lg-100">
                                <div class="o_breadcrumb d-flex flex-row flex-md-column min-w-0">
                                    <button type="button"
                                            class="btn oe_stat_button flex-grow-1 flex-lg-grow-0"
                                            data-tooltip="Save"
                                            t-att-class="this.hasUnsavedChange() ? 'btn-primary' : 'btn-outline-secondary'"
                                            t-att-disabled="!this.hasUnsavedChange() or this.isSaving()"
                                            t-on-click="() => this.saveScene()"
                                            title="Save drawing"
                                            aria-label="Save drawing">
                                        <i class="o_button_icon oi"
                                           t-att-data-icon="this.isSaving() ? 'refresh' : 'save'"/>
                                    </button>
                                </div>
                                <div class="me-auto"/>
                            </div>
                            <!-- middle -->
                            <div class="o_control_panel_actions d-empty-none d-flex align-items-center justify-content-start justify-content-lg-around order-2 order-lg-1 w-100 mw-100 w-lg-auto gap-1 h-lg-100">
                                <div class="o-form-buttonbox d-print-none position-relative d-flex o_not_full">
                                    <div class="d-flex gap-1 min-w-0">
                                        <div class="fw-bold fs-5 me-3">
                                            <t t-out="this.display_name()"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- right -->
                            <div class="o_control_panel_navigation d-flex flex-wrap flex-md-nowrap justify-content-end gap-1 gap-xl-3 order-1 order-lg-2 flex-grow-1 align-items-lg-center">
                                <button type="button" class="btn btn-light p-1" title="Reload scene" aria-label="Reload scene"
                                        data-tooltip="Reload scene"
                                        t-att-disabled="!this.isBridgeReady()"
                                        t-on-click="() => this.onReloadScene()">
                                    <i class="o_button_icon oi" data-icon="cached"/>
                                </button>
                            </div>
                        </div>
                    </div>
                    <main class="o_content flex-grow-1 d-flex flex-column" style="min-height: 0; overflow: hidden;">
                        <div class="position-relative flex-grow-1 d-flex flex-column" style="min-height: 0;">
                            <t t-if="!this.isBridgeReady()">
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-white bg-opacity-75"
                                     style="z-index: 10;">
                                    <div class="spinner-border text-primary me-2" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <span class="text-muted">
                                        Drawing loading
                                        <i class="oi oi-hourglass ms-1" role="img" aria-label="Loading"/>
                                    </span>
                                </div>
                            </t>
                            <iframe id="excalidraw-frame"
                                    t-ref="this.iframeRef"
                                    t-att-src="this.bridgeUrl"
                                    class="flex-grow-1 w-100"
                                    style="border: 0; min-height: 0; flex: 1 1 auto;"
                                    title="Excalidraw Panel"
                                    frameborder="0"
                                    allowfullscreen="true"/>
                        </div>
                    </main>
                </div>
            </div>
        </div>
    </t>
</templates>
