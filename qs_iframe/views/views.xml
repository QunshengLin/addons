<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--qs.iframe-->
        <record id="view_qs_iframe_list" model="ir.ui.view">
            <field name="name">View Qs Iframe list</field>
            <field name="model">qs.iframe</field>
            <field name="arch" type="xml">
                <list multi_edit="true" sample="1">
                    <field name="sequence" optional="show" widget="handle"/>
                    <field name="display_name" optional="show" class="text-danger"/>
                    <field name="name" optional="show" options="{&quot;color_field&quot;:&quot;sequence&quot;}"
                           widget="badge" on_change="1"/>
                    <field name="url" optional="show" widget="url"/>
                    <field name="color" optional="show" widget="color_picker"/>
                    <field name="active" optional="show" widget="boolean_toggle"/>
                </list>
            </field>
        </record>
        <record id="view_qs_iframe_form" model="ir.ui.view">
            <field name="name">View Qs Iframe Form</field>
            <field name="model">qs.iframe</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="display_name" class="text-danger"/>
                            </h1>
                        </div>
                        <group>
                            <group col="1" colspan="1">
                                <field name="name"/>
                            </group>
                            <group col="1" colspan="1">
                                <field name="url" widget="url"/>
                            </group>
                            <group col="1" colspan="1">
                                <field name="sequence"/>
                            </group>
                            <group col="1" colspan="1">
                                <field name="color" widget="color_picker"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_qs_iframe_search" model="ir.ui.view">
            <field name="name">View Qs Iframe Search</field>
            <field name="model">qs.iframe</field>
            <field name="arch" type="xml">
                <search string="Search">
                    <field name="url"/>
                    <field name="sequence"/>
                    <field name="color"/>
                    <field name="active"/>
                    <filter name="filter_group_Active" string="Active" context="{'group_by': 'active'}"/>
                    <filter domain="[(&quot;active&quot;, &quot;!=&quot;, True)]" name="filter_active"
                            string="Active"/>
                    <searchpanel>
                        <field name="create_uid" icon="menu" string="Create User"/>
                    </searchpanel>
                </search>
            </field>
        </record>
        <record id="view_qs_iframe_kanban" model="ir.ui.view">
            <field name="name">View Qs Iframe Kanban</field>
            <field name="model">qs.iframe</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_small_column" sample="1" quick_create="false"
                        highlight_color="color">
                    <field name="name"/>
                    <field name="url"/>
                    <field name="sequence"/>
                    <field name="color"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="menu">
                            <t t-if="widget.deletable">
                                <a type="delete" class="dropdown-item">Delete</a>
                            </t>
                            <field name="color" widget="kanban_color_picker"/>
                        </t>
                        <t t-name="card" class="flex-row">
                            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                            <main class="pe-2">
                                <div t-if="record.url.raw_value" class="text-truncate">
                                    <field class="col-8 text-primary" name="url"/>
                                </div>
                                <footer>
                                    <div class="d-flex mb-0 h5">
                                        <field name="display_name" class="text-danger"/>
                                    </div>
                                </footer>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <record id="act_window_qs_iframe" model="ir.actions.act_window">
            <field name="name">Iframe</field>
            <field name="res_model">qs.iframe</field>
            <field name="view_mode">list,kanban,form,search</field>
        </record>
        <!--前端动作-->
        <record id="action_iframe" model="ir.actions.client">
            <field name="name">Iframe</field>
            <field name="tag">qs_iframe.iframe</field>
        </record>
        <!--菜单-->
        <menuitem name="Iframe" id="qs_iframe.menu_root"
                  web_icon="qs_iframe,static/description/icon.png" action="qs_iframe.act_window_qs_iframe"/>
        <menuitem name="Setting" id="qs_iframe.menu_1" parent="qs_iframe.menu_root"
                  action="qs_iframe.action_iframe" sequence="50"/>
        <menuitem name="Iframe" id="qs_iframe.menu_2" parent="qs_iframe.menu_1"
                  action="qs_iframe.action_iframe" sequence="50"/>
        <menuitem name="Setting" id="qs_iframe.menu_3" parent="qs_iframe.menu_1"
                  action="qs_iframe.act_window_qs_iframe" sequence="50"/>
    </data>
</odoo>